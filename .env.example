# Copy to .env and adjust. Required for local development.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- Database ---
# Local Postgres via docker-compose:
DATABASE_URL=postgres://breathe:breathe@localhost:5432/breathe_esg
# Or leave blank to fall back to SQLite (./backend/db.sqlite3).

# --- Groq LLM (optional) ---
# If GROQ_API_KEY is empty, LLM suggestions are skipped silently and low-confidence
# rows go straight to manual analyst review.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_S=20

# --- Tenant seed ---
DEFAULT_TENANT_SLUG=demo-enterprise-client
DEFAULT_TENANT_NAME=Demo Enterprise Client

# --- Frontend dev ---
VITE_API_BASE_URL=http://localhost:8000
